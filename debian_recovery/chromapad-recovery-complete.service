[Unit]
Description=Touchscreen shutdown after verified ChromaPad recovery
Requires=chromapad-recovery.service
After=chromapad-recovery.service
ConditionPathExists=/etc/chromapad-usb
ConditionPathExistsGlob=/var/lib/chromapad-recovery/*/completed.json

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/chromapad-recovery/recovery_shutdown.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
UMask=0077
StandardOutput=append:/var/lib/chromapad-recovery/completion-service.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
