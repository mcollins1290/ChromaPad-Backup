#!/bin/sh
set -eu
case "${1:-}" in
  '')
    [ "$#" -eq 0 ] || exit 2
    systemctl start --no-block chromapad-debian-recovery-backup.service
    printf '%s\n' 'Backup and recovery-image build started.' 'Follow: sudo journalctl -fu chromapad-debian-recovery-backup.service' 'Latest completed image: /media/raid1/coprint_2_debian/output/debian-recovery-latest.img'
    ;;
  --plan)
    [ "$#" -eq 1 ] || exit 2
    exec /usr/bin/python3 /usr/local/lib/chromapad-recovery-builder/chromapad_recovery_backup.py --plan
    ;;
  --status)
    [ "$#" -eq 1 ] || exit 2
    exec systemctl status --no-pager chromapad-debian-recovery-backup.service
    ;;
  *) printf '%s\n' 'Usage: sudo chromapad-debian-recovery-backup [--plan|--status]' >&2; exit 2;;
esac
